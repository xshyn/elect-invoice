{
  "name": "jaryan-invoice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Persian invoicing web app for electricians — Next.js + PostgreSQL (Prisma), Dockerized",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:web": "next build",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "up": "docker compose up --build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jalaali-js": "^2.0.1",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
