// Prisma v7 schema — PostgreSQL.
// Connection URL lives in prisma.config.ts (env DATABASE_URL), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Singleton row (id = "default"). Holds the branding + numbering defaults
// that are stamped onto every new invoice.
model BusinessProfile {
  id            String   @id @default("default")
  name          String   @default("جریان")
  tagline       String   @default("")
  phones        String[]
  address       String   @default("")
  website       String   @default("")
  logoDataUrl   String   @default("")
  invoiceTitle  String   @default("صورتحساب")
  currency      String   @default("تومان")
  wordsUnit     String   @default("تومان")
  numberPrefix  String   @default("")
  nextNumber    Int      @default(101)
  theme         String   @default("amber")
  // Editable unit list (عدد، متر، …) offered per line-item; free text allowed.
  units         String[] @default(["عدد", "متر", "حلقه", "بسته", "دستگاه", "متر مربع", "کیلوگرم", "ساعت"])
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id              String     @id @default(uuid())
  number          String     @unique
  // Jalali date as "YYYY/MM/DD" (latin digits) + Gregorian ISO for reliable ordering.
  date            String
  gregorianISO    String
  title           String     @default("صورتحساب")
  buyerName       String     @default("")
  buyerPhone      String     @default("")
  discountEnabled Boolean    @default(false)
  discount        Float      @default(0)
  taxEnabled      Boolean    @default(false)
  taxRate         Float      @default(0)
  currency        String     @default("تومان")
  notes           String     @default("")
  // Denormalized caches, maintained on every write so list
  // sorting/filtering/pagination runs in SQL, not in JS.
  total           Float      @default(0)
  itemCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           LineItem[]

  @@index([gregorianISO])
  @@index([buyerName])
  @@index([total])
  @@index([updatedAt])
}

model LineItem {
  id        String  @id @default(uuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  position  Int     @default(0)
  desc      String
  qty       Float
  unitPrice Float
  // Optional unit (متر، عدد، …); free text, suggestions from BusinessProfile.units.
  unit      String  @default("")

  @@index([invoiceId])
}

// Auth: local username+password accounts. First user is created via the
// first-run setup screen at /login (no seeded credentials by design).
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  displayName  String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  drafts       Draft[]
}

model Session {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Long-lived sliding sessions: 90 days, refreshed on activity.
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String   @default("")

  @@index([userId])
  @@index([expiresAt])
}

// Autosaved editor drafts (browser-independent). One live draft per user for
// new invoices; consumed (deleted) once the invoice is actually saved.
model Draft {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  scope     String   @default("new")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope])
  @@index([userId])
}
