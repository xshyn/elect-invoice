# Copy to .env and adjust. Used by Prisma CLI, Next.js server, and docker compose.
DATABASE_URL="postgresql://jaryan:jaryan@localhost:5432/jaryan?schema=public"
# Secret for signing session cookies (min 16 chars). Generate: openssl rand -base64 32
SESSION_SECRET="dev-only-insecure-secret-change-me"
# If host port 5432 is taken (e.g. a system Postgres), set DB_PORT=5433 and
# point DATABASE_URL at localhost:5433 instead.
# DB_PORT=5432
# Inside docker compose the app reaches the DB at host `db` automatically (see compose file).
